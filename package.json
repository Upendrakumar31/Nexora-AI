{
  "name": "nexora-ai",
  "version": "1.0.0",
  "description": "Nexora AI - Modern AI Content Creation and Career Intelligence Suite",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run server",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "lint:client": "npm --prefix client run lint",
    "test:server": "npm --prefix server test",
    "test": "npm run test:server",
    "migrate": "npm --prefix server run migrate"
  }
}
